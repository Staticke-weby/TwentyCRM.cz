---
import Base from '../layouts/Base.astro';
---

<Base title="Stránka nenalezena | TwentyCRM.cz" description="Hledaná stránka neexistuje." noindex overlay>
  <section class="hero hero--velke soumrak zrno">
    <div class="kontejner">
      <div class="hero__vnitrek">
        <p class="stitek">Chyba 404</p>
        <h1>Stránka nenalezena</h1>
        <p class="hero__perex">
          Hledaná stránka neexistuje. Možná se ztratila při nasazení, nebo odkaz směřuje na nesprávné místo.
        </p>
        <div class="hero__akce">
          <a href="/" class="btn btn-primary btn-lg">Na úvodní stránku</a>
          <a href="/otazky/" class="btn btn-secondary btn-lg">Časté otázky</a>
        </div>
      </div>
    </div>
  </section>
</Base>
